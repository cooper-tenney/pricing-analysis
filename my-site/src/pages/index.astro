---
const name = "Cooper Tenney";
const tagline = "Data Science @ Stanford. Building practical tools with clean data workflows.";

const links = [
  { label: "GitHub", href: "https://github.com/cooper-tenney/" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/cooper-tenney/" },
  { label: "Email", href: "mailto:ctenney@stanford.edu" },
];

const projects = [
  {
    title: "Pricing Analytics Platform",
    desc: "Ingests datasets, runs data quality audits, and supports configurable modeling with diagnostics.",
    tags: ["Python", "Streamlit", "ML"],
    github: "https://github.com/cooper-tenney/",
    demo: "", // optional
  },
  {
    title: "WNBA Star Externality Study",
    desc: "Quantifies demand lift from star attention using prediction gaps from baseline models.",
    tags: ["Data Science", "Scraping", "Modeling"],
    github: "https://github.com/cooper-tenney/",
    demo: "",
  },
];

const bio = `
I’m a Stanford sophomore studying Data Science with an Economics minor.
I like building tools that make messy data usable and decisions clearer.
Currently: pricing analytics, sports analytics, and applied ML projects.
`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={`${name} portfolio`} />
    <style>
      :root {
        --bg: #ffffff;
        --text: #111111;
        --muted: #666666;
        --border: #eaeaea;
        --link: #111111;
        --max: 920px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0c;
          --text: #f2f2f2;
          --muted: #b0b0b0;
          --border: #1f1f22;
          --link: #f2f2f2;
        }
      }

      html, body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
      }

      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 56px 20px 80px;
      }

      header { margin-bottom: 40px; }
      h1 { font-size: 40px; line-height: 1.15; margin: 0 0 12px; letter-spacing: -0.02em; }
      .tagline { color: var(--muted); max-width: 70ch; margin: 0 0 18px; }

      .links { display: flex; gap: 14px; flex-wrap: wrap; }
      .pill {
        border: 1px solid var(--border);
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 14px;
      }

      section { margin-top: 44px; }
      h2 { font-size: 18px; margin: 0 0 14px; letter-spacing: 0.01em; }
      .grid { display: grid; gap: 14px; }

      .card {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px 16px 14px;
      }

      .cardtop { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
      .title { font-weight: 650; }
      .meta { display: flex; gap: 10px; font-size: 14px; color: var(--muted); }

      .desc { margin: 10px 0 12px; color: var(--muted); }

      .tags { display: flex; gap: 8px; flex-wrap: wrap; }
      .tag {
        font-size: 12px;
        border: 1px solid var(--border);
        padding: 4px 8px;
        border-radius: 999px;
        color: var(--muted);
      }

      .footer { margin-top: 60px; color: var(--muted); font-size: 14px; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
      .split { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    </style>
  </head>

  <body>
    <div class="wrap">
      <header>
        <h1>{name}</h1>
        <p class="tagline">{tagline}</p>
        <div class="links">
          {links.map((l) => (
            <a class="pill" href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
              {l.label}
            </a>
          ))}
        </div>
      </header>

      <section>
        <h2>Projects</h2>
        <div class="grid">
          {projects.map((p) => (
            <div class="card">
              <div class="cardtop">
                <div class="title">{p.title}</div>
                <div class="meta">
                  <a href={p.github} target="_blank" rel="noreferrer">Code</a>
                  {p.demo ? <a href={p.demo} target="_blank" rel="noreferrer">Demo</a> : null}
                </div>
              </div>
              <p class="desc">{p.desc}</p>
              <div class="tags">
                {p.tags.map((t) => (<span class="tag">{t}</span>))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>About</h2>
        <div class="card">
          <p style="margin: 0; white-space: pre-line;">{bio.trim()}</p>
        </div>
      </section>

      <div class="footer">
        <div class="split">
          <span>© {new Date().getFullYear()} {name}</span>
          <span class="mono">Built with Astro</span>
        </div>
      </div>
    </div>
  </body>
</html>